---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지를 찾을 수 없습니다. Sanbal Studio 홈과 앱 목록을 확인해 주세요.">
  <section class="section not-found" aria-labelledby="not-found-title">
    <div class="not-found__copy">
      <p class="eyebrow" lang="en">Page not found</p>
      <h1 id="not-found-title">이 길에는 아직<br /> <span>페이지가 없습니다</span></h1>
      <p class="lead">주소가 바뀌었을 수 있습니다. 홈이나 앱 목록에서 찾던 내용을 이어서 살펴보세요.</p>
      <nav class="not-found__actions" aria-label="오류 페이지 바로가기">
        <a class="button primary" href="/">홈으로 돌아가기</a>
        <a class="button secondary" href="/#apps">앱 둘러보기</a>
        <a class="not-found__contact" href="/contact">문의하기</a>
      </nav>
    </div>

    <div class="route-artifact" aria-hidden="true">
      <span class="route-artifact__code">404</span>
      <svg viewBox="0 0 420 220" role="presentation">
        <path class="route-artifact__path" d="M32 174c56-9 65-80 118-81 61-1 54 79 113 65 40-10 40-64 96-74" />
        <circle cx="32" cy="174" r="9" />
        <circle cx="359" cy="84" r="9" />
        <path class="route-artifact__break" d="m198 118 12 12m0-12-12 12" />
      </svg>
      <span class="route-artifact__caption" lang="en">Sanbal Studio · route not found</span>
    </div>
  </section>
</SiteLayout>

<style>
  .not-found {
    align-items: center;
    display: grid;
    gap: var(--space-12);
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    min-block-size: calc(100dvh - var(--header-height) - var(--space-20));
  }

  .not-found__copy {
    max-inline-size: 38rem;
    overflow-wrap: normal;
    word-break: keep-all;
  }

  .not-found h1 {
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    text-wrap: balance;
  }

  .not-found h1 span {
    white-space: nowrap;
  }

  .not-found .lead {
    margin: var(--space-6) 0 0;
    max-inline-size: 58ch;
  }

  .not-found__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }

  .not-found__contact {
    align-items: center;
    color: var(--color-brand-strong);
    display: inline-flex;
    font-weight: 700;
    min-block-size: calc(var(--space-10) + var(--space-1));
    padding-inline: var(--space-3);
    transition: color var(--motion-fast);
  }

  .not-found__contact:hover {
    color: var(--color-brand);
  }

  .route-artifact {
    background:
      linear-gradient(145deg, var(--color-on-dark-surface), transparent 46%),
      var(--color-hero);
    border: 1px solid var(--color-on-dark-line);
    border-radius: var(--radius-artifact);
    box-shadow: var(--shadow-artifact);
    color: var(--color-on-dark);
    display: grid;
    isolation: isolate;
    min-block-size: 28rem;
    overflow: hidden;
    padding: var(--space-8);
    position: relative;
  }

  .route-artifact::before {
    background:
      linear-gradient(var(--color-on-dark-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-on-dark-line) 1px, transparent 1px);
    background-size: var(--space-12) var(--space-12);
    content: '';
    inset: 0;
    opacity: 0.16;
    position: absolute;
    z-index: -1;
  }

  .route-artifact__code {
    color: var(--color-on-dark);
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.82;
  }

  .route-artifact svg {
    align-self: end;
    fill: var(--color-brand-soft);
    inline-size: 100%;
    overflow: visible;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .route-artifact__path {
    fill: none;
    stroke: var(--color-brand-soft);
    stroke-dasharray: var(--space-3) var(--space-3);
    stroke-width: 3;
  }

  .route-artifact__break {
    fill: none;
    stroke: var(--color-error);
    stroke-width: 4;
  }

  .route-artifact__caption {
    align-self: end;
    color: var(--color-on-dark-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 56.25rem) {
    .not-found {
      grid-template-columns: 1fr;
      padding-block-start: var(--space-16);
    }

    .not-found__copy {
      max-inline-size: var(--layout-narrow);
    }

    .route-artifact {
      min-block-size: 22rem;
    }
  }

  @media (max-width: 42.5rem) {
    .not-found h1 br {
      display: none;
    }

    .not-found__actions {
      align-items: stretch;
      display: grid;
      grid-template-columns: 1fr;
    }

    .not-found__contact {
      justify-content: center;
    }

    .route-artifact {
      min-block-size: 18rem;
      padding: var(--space-6);
    }
  }
</style>
