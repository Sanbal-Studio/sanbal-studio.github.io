---
import { studio } from '../data/apps';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/favicon.svg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://sanbal-studio.github.io');
const socialImage = new URL(image, Astro.site ?? 'https://sanbal-studio.github.io');
const fullTitle = title === studio.name ? title : `${title} | ${studio.name}`;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isAppsPage = pathname.startsWith('/apps/');
const isContactPage = pathname === '/contact';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f3f5ef" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
    <link
      rel="preload"
      as="style"
      crossorigin="anonymous"
      href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css"
    />
    <link
      rel="stylesheet"
      crossorigin="anonymous"
      href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css"
    />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={description} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="Sanbal Studio 홈">
          <span class="brand-mark" aria-hidden="true">S</span>
          <span>{studio.name}</span>
        </a>
        <nav class="site-nav" aria-label="주요 메뉴">
          <a href="/#apps" aria-current={isAppsPage ? 'page' : undefined} lang="en">Apps</a>
          <a href="/contact" aria-current={isContactPage ? 'page' : undefined} lang="en">Contact</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__copy">
          <strong>{studio.name}</strong>
          <p>{studio.tagline}</p>
        </div>
        <nav aria-label="Sanbal Studio 링크">
          <a href="/#apps" lang="en">Apps</a>
          <a href="/contact" lang="en">Contact</a>
          <a href={`mailto:${studio.email}`} lang="en">Email</a>
          <a href={studio.links.threads} target="_blank" rel="noopener noreferrer" lang="en" aria-label="Threads 새 창에서 열기">Threads</a>
          <a href={studio.links.x} target="_blank" rel="noopener noreferrer" lang="en" aria-label="X 새 창에서 열기">X</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-canvas: #f3f5ef;
    --color-surface: #fbfcf8;
    --color-surface-muted: #e8eee8;
    --color-surface-strong: #dce5dd;
    --color-ink: #162019;
    --color-ink-muted: #526057;
    --color-ink-subtle: #748078;
    --color-line: #d2dbd3;
    --color-line-strong: #7f8f83;
    --color-brand: #2f684d;
    --color-brand-strong: #17442f;
    --color-brand-soft: #dceade;
    --color-focus: #c2472d;
    --color-hero: #0d1712;
    --color-on-dark: #f6f7f2;
    --color-on-dark-muted: #c8d2cb;
    --color-on-dark-line: rgba(246, 247, 242, 0.36);
    --color-on-dark-surface: rgba(246, 247, 242, 0.09);
    --color-hero-scrim: rgba(7, 14, 10, 0.58);
    --color-success: #2f684d;
    --color-warning: #865b18;
    --color-error: #a33b2d;
    --color-info: #315f87;
    --color-product-picmory: #f1ecdf;
    --color-product-not-todo: #edf0e8;
    --color-product-walk-bingo: #e2ece3;
    --font-display: "Wanted Sans Variable", "Wanted Sans", -apple-system, BlinkMacSystemFont, system-ui, "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif;
    --font-body: var(--font-display);
    --font-mono: var(--font-display);
    --text-display: clamp(3.5rem, 8vw, 7.5rem);
    --text-h1: clamp(2.5rem, 6vw, 5rem);
    --text-h2: clamp(2rem, 4vw, 3.5rem);
    --text-h3: 1.375rem;
    --text-body-lg: clamp(1.0625rem, 2vw, 1.25rem);
    --text-body: 1rem;
    --text-body-sm: 0.875rem;
    --text-label: 0.8125rem;
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;
    --space-24: 6rem;
    --layout-max: 75rem;
    --layout-narrow: 48rem;
    --header-height: 4.5rem;
    --radius-control: 0.625rem;
    --radius-panel: 1.25rem;
    --radius-artifact: 1.75rem;
    --radius-round: 999px;
    --size-icon-sm: 3.5rem;
    --size-icon-md: 4.5rem;
    --size-icon-lg: 5.5rem;
    --size-icon-xl: 6.5rem;
    --shadow-subtle: 0 1px 2px rgba(22, 32, 25, 0.06), 0 8px 24px rgba(22, 32, 25, 0.05);
    --shadow-elevated: 0 18px 48px rgba(20, 43, 30, 0.14);
    --shadow-artifact: 0 28px 80px rgba(4, 11, 7, 0.34);
    --motion-fast: 140ms ease-out;
    --motion-standard: 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    --motion-emphasis: 480ms cubic-bezier(0.16, 1, 0.3, 1);
    color-scheme: light;
    font-family: var(--font-body);
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--color-canvas);
    color: var(--color-ink);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      radial-gradient(circle at 8% 6%, color-mix(in srgb, var(--color-brand-soft) 70%, transparent), transparent 30rem),
      var(--color-canvas);
    color: var(--color-ink);
    font-size: var(--text-body);
    font-weight: 430;
    line-height: 1.72;
    text-rendering: optimizeLegibility;
  }

  main {
    min-height: 60dvh;
  }

  img {
    display: block;
    height: auto;
    max-width: 100%;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  a {
    color: inherit;
    text-decoration-thickness: 0.075em;
    text-underline-offset: 0.2em;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: var(--space-1);
  }

  ::selection {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }

  .skip-link {
    background: var(--color-ink);
    border-radius: var(--radius-control);
    color: var(--color-on-dark);
    left: var(--space-4);
    padding: var(--space-3) var(--space-4);
    position: fixed;
    top: calc(-1 * var(--space-20));
    z-index: 20;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .site-header {
    background: color-mix(in srgb, var(--color-canvas) 90%, transparent);
    backdrop-filter: blur(18px) saturate(120%);
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 82%, transparent);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--layout-max);
    min-height: var(--header-height);
    padding: 0 var(--space-8);
  }

  .brand,
  .site-nav,
  .site-footer nav,
  .button-row {
    align-items: center;
    display: flex;
    gap: var(--space-3);
  }

  .brand {
    border-radius: var(--radius-control);
    font-weight: 760;
    min-height: 44px;
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-1);
    text-decoration: none;
    transition: color var(--motion-fast);
  }

  .brand:hover {
    color: var(--color-brand-strong);
  }

  .brand-mark {
    align-items: center;
    background:
      radial-gradient(circle at 28% 20%, color-mix(in srgb, var(--color-brand) 62%, var(--color-on-dark)), transparent 34%),
      var(--color-ink);
    border: 1px solid color-mix(in srgb, var(--color-on-dark) 18%, transparent);
    border-radius: var(--radius-control);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-on-dark) 18%, transparent);
    color: var(--color-on-dark);
    display: inline-flex;
    flex: 0 0 auto;
    height: 36px;
    justify-content: center;
    width: 36px;
  }

  .site-nav {
    gap: var(--space-1);
  }

  .site-nav a {
    align-items: center;
    border-radius: var(--radius-control);
    color: var(--color-ink-muted);
    display: inline-flex;
    font-size: var(--text-body-sm);
    font-weight: 700;
    min-height: 44px;
    padding: 0 var(--space-4);
    text-decoration: none;
    transition: background-color var(--motion-fast), color var(--motion-fast);
  }

  .site-nav a:hover {
    background: var(--color-surface-muted);
    color: var(--color-ink);
  }

  .site-nav a[aria-current="page"] {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }

  .site-footer {
    border-top: 1px solid var(--color-line);
    margin-top: var(--space-24);
  }

  .site-footer__inner {
    align-items: center;
    display: flex;
    gap: var(--space-8);
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-10) var(--space-8) var(--space-12);
  }

  .site-footer__copy {
    max-width: 34rem;
  }

  .site-footer p {
    color: var(--color-ink-muted);
    margin: var(--space-1) 0 0;
  }

  .site-footer nav {
    flex-wrap: wrap;
    justify-content: flex-end;
    row-gap: var(--space-1);
  }

  .site-footer a {
    align-items: center;
    border-radius: var(--radius-control);
    color: var(--color-ink-muted);
    display: inline-flex;
    font-size: var(--text-body-sm);
    font-weight: 700;
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-2);
    justify-content: center;
    text-decoration: none;
    transition: color var(--motion-fast);
  }

  .site-footer a:hover {
    color: var(--color-brand-strong);
  }

  .section {
    margin: 0 auto;
    max-width: var(--layout-max);
    padding: var(--space-24) var(--space-8) 0;
  }

  .section.narrow {
    max-width: calc(var(--layout-narrow) + (var(--space-8) * 2));
  }

  .eyebrow {
    color: var(--color-brand);
    font-size: var(--text-label);
    font-weight: 750;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
    word-break: keep-all;
    text-wrap: pretty;
  }

  h1,
  h2,
  h3 {
    color: var(--color-ink);
    margin: 0;
  }

  h1,
  h2 {
    font-family: var(--font-display);
    font-weight: 650;
    text-wrap: balance;
  }

  h1 {
    font-size: var(--text-h1);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  h2 {
    font-size: var(--text-h2);
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  h3 {
    font-size: var(--text-h3);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .lead {
    color: var(--color-ink-muted);
    font-size: var(--text-body-lg);
    line-height: 1.7;
    max-width: 42rem;
  }

  .button-row {
    flex-wrap: wrap;
  }

  .button {
    align-items: center;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    display: inline-flex;
    font-size: var(--text-body-sm);
    font-weight: 750;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    text-decoration: none;
    transition:
      background-color var(--motion-fast),
      border-color var(--motion-fast),
      color var(--motion-fast),
      box-shadow var(--motion-fast),
      transform var(--motion-standard);
  }

  .button:hover {
    box-shadow: var(--shadow-subtle);
    transform: translateY(-1px);
  }

  .button:active {
    box-shadow: none;
    transform: translateY(1px);
  }

  .button.primary {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-on-dark);
  }

  .button.primary:hover {
    background: var(--color-brand-strong);
    border-color: var(--color-brand-strong);
  }

  .button.secondary {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .button.secondary:hover {
    border-color: var(--color-brand);
    color: var(--color-brand-strong);
  }

  .button.subtle {
    background: transparent;
    border-color: transparent;
    color: var(--color-ink-muted);
  }

  .button.subtle:hover {
    background: var(--color-surface-muted);
    color: var(--color-brand-strong);
  }

  .button[aria-disabled="true"],
  .button:disabled {
    box-shadow: none;
    cursor: not-allowed;
    opacity: 0.55;
    pointer-events: none;
    transform: none;
  }

  .status-pill {
    align-items: center;
    background: var(--color-brand-soft);
    border: 1px solid color-mix(in srgb, var(--color-brand) 22%, transparent);
    border-radius: var(--radius-round);
    color: var(--color-brand-strong);
    display: inline-flex;
    font-size: var(--text-label);
    font-weight: 750;
    letter-spacing: 0.02em;
    min-height: 28px;
    padding: var(--space-1) var(--space-3);
    width: fit-content;
  }

  .status-pill[data-status="comingSoon"] {
    background: color-mix(in srgb, var(--color-warning) 12%, var(--color-surface));
    border-color: color-mix(in srgb, var(--color-warning) 24%, transparent);
    color: var(--color-warning);
  }

  .prose {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    color: var(--color-ink);
    font-size: var(--text-body);
    max-width: 68ch;
    padding: clamp(var(--space-6), 5vw, var(--space-12));
  }

  .prose > :first-child {
    margin-top: 0;
  }

  .prose > :last-child {
    margin-bottom: 0;
  }

  .prose h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: var(--space-12) 0 var(--space-5);
  }

  .prose h3 {
    margin: var(--space-10) 0 var(--space-4);
  }

  .prose h4 {
    font-size: var(--text-body-lg);
    margin: var(--space-8) 0 var(--space-3);
  }

  .prose p,
  .prose li,
  .prose dd {
    color: var(--color-ink-muted);
  }

  .prose li {
    word-break: keep-all;
  }

  .prose p,
  .prose ul,
  .prose ol,
  .prose dl,
  .prose blockquote,
  .prose pre,
  .prose table {
    margin: 0 0 var(--space-5);
  }

  .prose ul,
  .prose ol {
    padding-left: var(--space-6);
  }

  .prose li + li {
    margin-top: var(--space-2);
  }

  .prose a {
    color: var(--color-brand-strong);
    font-weight: 700;
    overflow-wrap: anywhere;
    transition: color var(--motion-fast);
  }

  .prose a:hover {
    color: var(--color-brand);
  }

  .prose code {
    background: var(--color-surface-muted);
    border-radius: calc(var(--radius-control) / 2);
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.15em 0.35em;
    word-break: keep-all;
  }

  .prose pre {
    background: var(--color-ink);
    border-radius: var(--radius-control);
    color: var(--color-on-dark);
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-4);
  }

  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .prose blockquote {
    border-left: var(--space-1) solid var(--color-brand);
    margin-left: 0;
    padding-left: var(--space-5);
  }

  .prose table {
    border-collapse: collapse;
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  .prose th,
  .prose td {
    border-bottom: 1px solid var(--color-line);
    min-width: 10rem;
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
  }

  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (max-width: 900px) {
    .site-footer__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer nav {
      justify-content: flex-start;
    }
  }

  @media (max-width: 680px) {
    :root {
      --header-height: 4rem;
    }

    .site-header__inner {
      padding: 0 var(--space-3);
    }

    .brand {
      font-size: var(--text-body-sm);
      gap: var(--space-2);
      padding-right: var(--space-1);
    }

    .brand-mark {
      height: 32px;
      width: 32px;
    }

    .site-nav a {
      padding: 0 var(--space-2);
    }

    .site-footer__inner {
      padding: var(--space-8) var(--space-5) var(--space-10);
    }

    .site-footer nav {
      display: grid;
      gap: var(--space-1) var(--space-3);
      grid-template-columns: repeat(3, max-content);
    }

    .section {
      padding: var(--space-16) var(--space-5) 0;
    }

    .prose {
      border-radius: var(--radius-control);
      margin-left: calc(-1 * var(--space-1));
      margin-right: calc(-1 * var(--space-1));
      padding: var(--space-6) var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }

    .button:hover,
    .button:active {
      transform: none;
    }
  }
</style>
